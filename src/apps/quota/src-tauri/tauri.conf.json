{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent HUD Quota",
  "version": "0.2.0",
  "identifier": "com.leandro.agenthud.quota",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent HUD ? ??",
        "width": 380,
        "height": 800,
        "minWidth": 320,
        "minHeight": 400,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../../desktop/src-tauri/icons/icon.ico",
      "../../desktop/src-tauri/icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyNjYzQjM1NTBDNkFBMjkKUldRcHFzWlFOVHRtY25LdlBJQ3RQeWN4NmNUWmRzK3hNMks5UVRqdFFDWmlDTzM4TGhpQnhvMUwK",
      "endpoints": [
        "https://raw.githubusercontent.com/Leandro162/agent-hud-open/quota-panel/updates/quota-stable.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
